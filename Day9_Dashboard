   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Dataset\n",
    "students = [\"Tharun\", \"Rahul\", \"Priya\", \"Anjali\", \"Kiran\"]\n",
    "marks = [85, 90, 88, 95, 75]\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    \"Students\": students,\n",
    "    \"Marks\": marks\n",
    "})\n",
    "\n",
    "print(\"===== DAY 9 MINI DASHBOARD =====\")\n",
    "\n",
    "# Analysis\n",
    "print(\"\\nTotal Marks:\", df[\"Marks\"].sum())\n",
    "print(\"Average Marks:\", df[\"Marks\"].mean())\n",
    "print(\"Minimum Marks:\", df[\"Marks\"].min())\n",
    "print(\"Maximum Marks:\", df[\"Marks\"].max())\n",
    "print(\"Total Students:\", df[\"Marks\"].count())\n",
    "\n",
    "# Dashboard\n",
    "plt.figure(figsize=(15,4))\n",
    "\n",
    "# Bar Chart\n",
    "plt.subplot(1,3,1)\n",
    "plt.bar(df[\"Students\"], df[\"Marks\"])\n",
    "plt.title(\"Bar Chart\")\n",
    "plt.xlabel(\"Students\")\n",
    "plt.ylabel(\"Marks\")\n",
    "\n",
    "# Line Chart\n",
    "plt.subplot(1,3,2)\n",
    "plt.plot(df[\"Students\"], df[\"Marks\"], marker=\"o\")\n",
    "plt.title(\"Line Chart\")\n",
    "plt.xlabel(\"Students\")\n",
    "plt.ylabel(\"Marks\")\n",
    "\n",
    "# Pie Chart\n",
    "plt.subplot(1,3,3)\n",
    "plt.pie(df[\"Marks\"], labels=df[\"Students\"], autopct=\"%1.1f%%\", startangle=90)\n",
    "plt.title(\"Pie Chart\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\n===== DAY 9 COMPLETED SUCCESSFULLY =====\")\n"
   ]
